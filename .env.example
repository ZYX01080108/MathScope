# Configuration reference only: this project does NOT automatically load .env.
# Set these values in PowerShell before starting Uvicorn (see README).
# Unset all three to keep the original project/data defaults.

# MATHSCOPE_DATA_DIR=D:/MathScope-data
# MATHSCOPE_BASELINE_CHUNKS=D:/MathScope-experiments/lecture.chunks.jsonl
# MATHSCOPE_INDEX_CACHE_SIZE=4

# DeepSeek: opt-in only, configured in the server terminal. No real key here.
# See docs/deepseek-guide.md for masked PowerShell input and a 3-attempt first run.
# This reference file is NOT loaded automatically.
# MATHSCOPE_DEEPSEEK_ENABLED=0
# DEEPSEEK_API_KEY=<set privately in your terminal; never commit>
# MATHSCOPE_DEEPSEEK_MAX_CALLS=10
